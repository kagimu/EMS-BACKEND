# EMS Release 1 — integration test configuration (example)
#
# Copy to a local file and export the values before running:
#   go test ./integration/...
#
# When TEST_APP_DB_HOST is unset, integration tests skip automatically.
# The database is expected to be a disposable copy of a working Education
# database, already seeded with one known administrator.

# Test database connection
$env:APP_DB_HOST="localhost"
$env:APP_DB_PORT="3306"
$env:APP_DB_USERNAME="root"
$env:APP_DB_PASSWORD="root"
$env:APP_DB_NAME="db_wholesome_onboarding_test"

$env:DEV_RESET_ENABLED="true"
$env:DEV_ONBOARDING_DB_NAME="db_wholesome_onboarding_test"