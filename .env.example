APP_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:2054"

# Comma-separated user numbers allowed to operate the software-owner control
# plane. This is an explicit deployment grant, not an account type. Leave empty
# unless this deployment is the vendor/owner installation.
EMS_SOFTWARE_OWNER_USER_NUMBERS=

# Developer-only first-time-setup reset (disposable onboarding database).
# Keep DEV_RESET_ENABLED=false everywhere except a disposable test environment.
DEV_RESET_ENABLED=false
DEV_ONBOARDING_DB_NAME=db_wholesome_onboarding_test

# Mobile-money payments. Leave providers disabled until the telecom merchant
# account is approved and the callback URL is publicly reachable over HTTPS.
PAYMENTS_MAX_AMOUNT_UGX=100000000
PAYMENTS_PENDING_STALE_MINUTES=30
PAYMENTS_PROVIDER_TIMEOUT_SECONDS=35
PAYMENTS_RECONCILIATION_ENABLED=false
PAYMENTS_RECONCILIATION_INTERVAL_SECONDS=120
PAYMENTS_RECONCILIATION_MAX_ATTEMPTS=12

# Manual payment fallback. Fill the account details; blanks are hidden in the UI.
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_MTN_NAME=
MANUAL_PAYMENT_MTN_NUMBER=
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_BANK_ACCOUNT_NAME=
MANUAL_PAYMENT_BANK_ACCOUNT_NUMBER=
MANUAL_PAYMENT_BANK_BRANCH=
MANUAL_PAYMENT_INSTRUCTIONS=
MANUAL_PAYMENT_NOTIFY_EMAIL=
MANUAL_PAYMENT_PROOF_DIR=./storage/manual-payment-proofs
MANUAL_PAYMENT_MAX_PROOF_MB=10

# MTN MoMo Collections. Subscribe to "Collections" in the MTN MoMo Developer
# Portal, then create an API user and API key for the target environment.
MTN_MOMO_ENABLED=false
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=UGX
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_TIMEOUT_SECONDS=25

# Airtel Money Collections. Create an app in Airtel Africa Developer Studio and
# have the merchant/collection service enabled by Airtel Business.
AIRTEL_MONEY_ENABLED=false
AIRTEL_MONEY_ENVIRONMENT=uat
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_CONTRACT_VERIFIED=false
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_CALLBACK_URL=
AIRTEL_MONEY_TIMEOUT_SECONDS=25

